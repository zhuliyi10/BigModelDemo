# 复制本文件为 .env 并填入真实密钥
# ANTHROPIC_API_KEY=your-api-key
# 默认模型 ID（可选，如 glm-4.5-air）
# MODEL_ID=your-model-id
# Anthropic 兼容端点地址（如智谱 https://open.bigmodel.cn/api/anthropic）
# ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# 旧变量名，仍兼容（ANTHROPIC_BASE_URL 优先）
# GATEWAY_BASE=your-gateway-base-url
# PORT=3001
# 高德开放平台 Web 服务 Key（出行助手模式必需）：https://console.amap.com/dev/key/app
# AMAP_KEY=your-amap-key
# 高德 JS API Key + 安全密钥（可选：配置后卡片底图升级为可交互地图；不配置则为静态图，点击跳转高德路线页）
# AMAP_JS_KEY=your-jsapi-key
# AMAP_JS_SECURITY=your-security-code
# 美团酒旅 Skill Token（美团酒旅模式）：美团开发者中心 → 个人开发者控制台 → Token 管理
# https://developer.meituan.com/zh/v2/dev/doc（未配置时也可依赖 mttravel CLI 自身的 ~/.config/meituan-travel/config.json）
# MEITUAN_TOKEN=your-meituan-token
# 美团酒旅 CLI 单次查询超时（秒，官方耗时约 1-2 分钟）
# MTTRAVEL_TIMEOUT=150
# 美团跑腿 Skill 包路径（默认 server/skills/meituan-paotui，从美团开放平台 AI Hub 下载解压）
# MEITUAN_PAOTUI_DIR=
# 美团用户授权 Token（可选）；不配置时自动使用 pt-passport 扫码授权缓存（~/.xiaomei-workspace/pt_passport_auth.json，30 天有效）
# MEITUAN_PASSPORT_TOKEN=
# 跑腿命令超时（秒）；confirm_auth 扫码等待单独配置
# PAOTUI_TIMEOUT=120
# PAOTUI_CONFIRM_TIMEOUT=620
